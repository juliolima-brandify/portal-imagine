{
  "name": "portal-imagine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File ./start-clean.ps1",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force .next,node_modules\\.cache -ErrorAction SilentlyContinue\"",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "@vinext/cloudflare": "latest",
    "chart.js": "^4.4.1",
    "date-fns": "^3.0.6",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.3",
    "next": "14.0.4",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-day-picker": "^8.10.0",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "latest",
    "vinext": "latest",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vite": "latest",
    "wrangler": "latest"
  },
  "type": "module"
}
