# Configurações de Produção para CapRover
# Copie este arquivo para .env.production e configure as variáveis

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Asaas
ASAAS_ENV=production
ASAAS_API_KEY=your_asaas_production_api_key
ASAAS_WEBHOOK_TOKEN=your_asaas_webhook_token
RESEND_API_KEY=your_resend_api_key

# Next.js
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your_nextauth_secret

# Configurações do Instituto
NEXT_PUBLIC_INSTITUTE_NAME="Instituto Imagine"
NEXT_PUBLIC_INSTITUTE_URL="https://imagineinstituto.com"

# Configurações de Email (opcional)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Configurações de Upload
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

