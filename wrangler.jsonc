{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instituto-imagine",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "imagineinstituto.com", "custom_domain": true },
    { "pattern": "www.imagineinstituto.com", "custom_domain": true },
    { "pattern": "portal.imagineinstituto.com", "custom_domain": true }
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*",
      "!/img/*",
      "!/images/*",
      "!/favicon.ico"
    ]
  }
}
